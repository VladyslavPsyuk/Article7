import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# ==========================================
# 1. INPUT DATA & PLANT COEFFICIENTS
# ==========================================
plants = pd.DataFrame(
    {
        "Plant": ["Slite", "Aalborg Portland", "Brevik", "Górażdże"],
        "Qcapt": [1.80, 1.42, 0.40, 2.457],  # mln t/year
        "P_elec": [36, 70, 51, 96],  # €/MWh
        "P_CO2": [83, 83, 83, 83],  # €/t
        "E_spec_Pelec_table": [32.40, 63.00, 45.90, 86.40],
        "OPEX_spec": [30, 30, 30, 30],  # €/t
        "CAPEX_total": [165.0, 142.0, 58.0, 205.0],  # mln €
        "CRF": [0.08, 0.08, 0.08, 0.08],
        "sigma": [0.40, 0.40, 0.40, 0.40],
    }
)

S = 0.0  # Carbon subsidy (€/t)
eta_actual = 0.90  # Base capture efficiency

plants["E_spec"] = plants["E_spec_Pelec_table"] / plants["P_elec"]
plants["E0"] = plants["E_spec"] * (1 - eta_actual)

# Grid configuration for functional point search
eta = np.linspace(0.10, 0.95, 300)
Pco2 = np.linspace(30, 150, 300)
ETA, PCO2 = np.meshgrid(eta, Pco2)


# ==========================================
# 2. REGRESSION MODELS
# ==========================================
def f_full_econometric(eta_grid, plant_row, var=0.15):
    Qmax = plant_row["Qcapt"] / eta_actual
    capacity = Qmax
    labor_hours = 12000 * Qmax
    total_cement_prod = eta_grid * Qmax * 1.5
    num_kilns = 2.0
    pct_masonry, pct_4_or_other, pct_wet = 0.15, 0.20, 0.05

    beta0, beta1, beta2, beta3 = 0.80, -0.04, 0.02, 0.12
    beta4, beta5, beta6, beta7 = 0.05, -0.08, 0.03, 0.15

    E_i = (
        beta0
        + beta1 * np.log(capacity)
        + beta2 * np.log(labor_hours)
        + beta3 * np.log(total_cement_prod)
        + beta4 * np.log(num_kilns)
        + beta5 * pct_masonry
        + beta6 * pct_4_or_other
        + beta7 * pct_wet
    )

    ref_prod = eta_actual * Qmax * 1.5
    E_i_ref = (
        beta0
        + beta1 * np.log(capacity)
        + beta2 * np.log(labor_hours)
        + beta3 * np.log(ref_prod)
        + beta4 * np.log(num_kilns)
        + beta5 * pct_masonry
        + beta6 * pct_4_or_other
        + beta7 * pct_wet
    )

    f_m = (
        plant_row["E_spec"]
        * (E_i / E_i_ref)
        * (1.0 + 0.45 * (eta_grid / eta_actual - 1.0))
    )
    return f_m, f_m * (1 - var), f_m * (1 + var)


def f_logarithmic(eta_grid, plant_row, var=0.15):
    E0_val = plant_row["E0"]
    base = 0.5 + 0.38 * np.log(eta_grid + 0.1)
    scale = (E0_val / (1 - eta_actual)) / (
        0.5 + 0.38 * np.log(eta_actual + 0.1)
    )
    f_m = base * scale
    return f_m, f_m * (1 - var), f_m * (1 + var)


def f_exponential(eta_grid, plant_row, var=0.15):
    E0_val = plant_row["E0"]
    base = 0.18 * np.exp(2.1 * eta_grid)
    scale = (E0_val / (1 - eta_actual)) / (0.18 * np.exp(2.1 * eta_actual))
    f_m = base * scale
    return f_m, f_m * (1 - var), f_m * (1 + var)


def f_power_law(eta_grid, plant_row, beta=0.65, var=0.15):
    E0_val = plant_row["E0"]
    f_m = E0_val / ((1 - eta_grid) ** beta)
    return f_m, f_m * (1 - var), f_m * (1 + var)


scenarios = {
    "Full Econometric": f_full_econometric,
    "Logarithmic": f_logarithmic,
    "Exponential": f_exponential,
    "Power Law": f_power_law,
}


# ==========================================
# 3. BREAK-EVEN ENGINE WITH MIN FUNCTIONAL BASELINE
# ==========================================
def calculate_min_functional_point(plant_row, sc_func):
    """Finds the minimum P_CO2 break-even point on the grid where F >= 0."""
    Qmax = plant_row["Qcapt"] / eta_actual
    P_elec_val = plant_row["P_elec"]
    OPEX_fixed = plant_row["OPEX_spec"] * plant_row["Qcapt"]

    E_spec_m, _, _ = sc_func(ETA, plant_row)
    OPEX_spec_mesh = OPEX_fixed / (ETA * Qmax)

    Phi_m = PCO2 + S - (E_spec_m * P_elec_val) - OPEX_spec_mesh
    F_m = ETA * Qmax * Phi_m

    feasible_mask = F_m >= 0
    if np.any(feasible_mask):
        feasible_indices = np.where(feasible_mask)
        min_pos = np.argmin(PCO2[feasible_indices])
        i_min = feasible_indices[0][min_pos]
        j_min = feasible_indices[1][min_pos]
        return PCO2[i_min, j_min]
    else:
        return 50.0  # Default fallback if unconstrained


def calculate_breakeven_regimes(plant_row, sc_func):
    """Computes investment regime break-evens based on Minimum Line scaling."""
    p_min_operational = calculate_min_functional_point(plant_row, sc_func)

    Qmax = plant_row["Qcapt"] / eta_actual
    CAPEX = plant_row["CAPEX_total"]
    CRF = plant_row["CRF"]
    sigma = plant_row["sigma"]

    # Investment additions
    capex_comm = (CAPEX * CRF) / (eta_actual * Qmax)
    capex_sub = (CAPEX * (1 - sigma) * CRF) / (eta_actual * Qmax)

    # Base minimum functional values per regime
    min_op = p_min_operational
    min_comm = p_min_operational + capex_comm
    min_sub = p_min_operational + capex_sub

    # Rule: Mid = Min + 15%, Max = Min + 25%
    regimes = {
        "Operational": (min_op * 1.15, min_op, min_op * 1.25),
        "Commercial": (min_comm * 1.15, min_comm, min_comm * 1.25),
        "Subsidized": (min_sub * 1.15, min_sub, min_sub * 1.25),
    }
    return regimes


# ==========================================
# 4. PLOTTING CANDLESTICK SUMMARY
# ==========================================
fig, axes = plt.subplots(2, 2, figsize=(16, 12))
axes = axes.flatten()

inv_models = ["Operational", "Commercial", "Subsidized"]
plant_names = plants["Plant"].tolist()

n_plants = len(plant_names)
x = np.arange(n_plants)
width = 0.25
colors = ["#4c72b0", "#dd8452", "#55a868"]

for sc_idx, (sc_name, sc_func) in enumerate(scenarios.items()):
    ax = axes[sc_idx]

    for m_idx, model in enumerate(inv_models):
        mids, err_low, err_high = [], [], []

        for _, row in plants.iterrows():
            reg_dict = calculate_breakeven_regimes(row, sc_func)
            mid, p_min, p_max = reg_dict[model]

            mids.append(mid)
            err_low.append(mid - p_min)  # Lower candle arm (15% gap)
            err_high.append(p_max - mid)  # Upper candle arm (10% gap)

        pos = x + (m_idx - 1) * width

        # Bar heights: Middle scenario (Minimum + 15%)
        bars = ax.bar(
            pos,
            mids,
            width,
            label=model,
            color=colors[m_idx],
            edgecolor="black",
            alpha=0.9,
        )

        # Error bars: Min line (bottom) to Max line (+25%, top)
        ax.errorbar(
            pos,
            mids,
            yerr=[err_low, err_high],
            fmt="none",
            ecolor="black",
            capsize=4,
            capthick=1.2,
            elinewidth=1.2,
            zorder=5,
        )

        # Values plotted above bars
        for bar, mid_val in zip(bars, mids):
            ax.text(
                bar.get_x() + bar.get_width() / 2.0,
                bar.get_height() + 2.0,
                f"{mid_val:.1f}",
                ha="center",
                va="bottom",
                fontsize=8,
                rotation=45,
            )

    ax.set_title(f"Scenario: {sc_name}", fontsize=12, fontweight="bold")
    ax.set_ylabel(r"Break-Even $P_{\text{CO2, BE}}$ (€/t)", fontsize=10)
    ax.set_xticks(x)
    ax.set_xticklabels(plant_names, fontweight="bold")
    ax.grid(True, linestyle=":", alpha=0.6, axis="y")
    ax.legend(loc="upper left", fontsize=8.5, framealpha=0.9)
    ax.set_ylim(0, 180)

plt.suptitle(
    r"Break-Even $P_{\text{CO2,BE}}$ with Minimum Line Baseline (Bars = +15%, Candle Max = +25%)",
    fontsize=15,
    fontweight="bold",
    y=0.99,
)
plt.tight_layout()
plt.show()
