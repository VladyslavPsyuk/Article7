im = ax2.imshow(heatmap_data, cmap="RdYlGn", aspect="auto")

ax2.set_xticks(np.arange(len(df_scenario_pivot.columns)))
ax2.set_yticks(np.arange(len(df_scenario_pivot.index)))
ax2.set_xticklabels(df_scenario_pivot.columns, fontweight="bold")
ax2.set_yticklabels(df_scenario_pivot.index, fontweight="bold")

# Annotate values inside the heatmap
for i in range(len(df_scenario_pivot.index)):
