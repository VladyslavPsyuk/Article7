        ax2.text(j, i, f"{val:.2f} M€", ha="center", va="center", color=text_color, fontweight="bold")

cbar = fig2.colorbar(im, ax=ax2)
cbar.set_label("Annual Profit (Mln € / year)", fontweight="bold")
