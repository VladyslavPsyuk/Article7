        "OPEX_mult": 1.1,
    },
    "Sorbent Cost Spike": {"P_CO2": 83.0, "P_elec_mult": 1.0, "OPEX_mult": 1.4},
}

scenario_results = []
for _, row in plants.iterrows():
    for sc_name, sc_params in scenarios_def.items():
        p_c = sc_params["P_CO2"]
        p_e = row["P_elec"] * sc_params["P_elec_mult"]
        o_s = row["OPEX_spec"] * sc_params["OPEX_mult"]

        fin = calculate_plant_financials(0.90, p_c, p_e, o_s, row)

        scenario_results.append(
            {
                "Plant": row["Plant"],
                "Scenario": sc_name,
                "Profit (Mln €/yr)": round(fin["Profit"] / 1e6, 3),
                "Revenue (Mln €/yr)": round(fin["Revenue"] / 1e6, 3),
                "Total Cost (Mln €/yr)": round(fin["Total_Cost"] / 1e6, 3),
            }
        )

df_scenarios = pd.DataFrame(scenario_results)
print(df_scenarios.pivot(index="Plant", columns="Scenario", values="Profit (Mln €/yr)").to_string())


# ==========================================
# 5. GLOBAL SENSITIVITY ANALYSIS (MORRIS METHOD)
# ==========================================
print("\n" + "=" * 80)
print("3. GLOBAL SENSITIVITY ANALYSIS (MORRIS ELEMENTARY EFFECTS)")
print("=" * 80)


def morris_screening(plant_row, num_trajectories=100, num_levels=4):
    """Calculates Elementary Effects: mu* (absolute mean) and sigma (interactions/non-linearity)."""
    # Normalized bounds [Min, Max]
    param_bounds = {
        "eta": [0.50, 0.95],
        "P_CO2": [40.0, 140.0],
        "P_elec": [30.0, 120.0],
        "OPEX_spec": [15.0, 45.0],
    }

    param_names = list(param_bounds.keys())
    k = len(param_names)
    ee_store = {p: [] for p in param_names}

    grid_step = num_levels / (2 * (num_levels - 1))

    for _ in range(num_trajectories):
        # Base random point scaled to grid
        x_base = np.zeros(k)
        for i, (p, bounds) in enumerate(param_bounds.items()):
            grid_points = np.linspace(bounds[0], bounds[1], num_levels)
            x_base[i] = np.random.choice(grid_points)

        # Base evaluation
        p_dict = dict(zip(param_names, x_base))
        fin_base = calculate_plant_financials(
            p_dict["eta"],
            p_dict["P_CO2"],
            p_dict["P_elec"],
            p_dict["OPEX_spec"],
            plant_row,
        )
        y_base = fin_base["Profit"] / 1e6  # Mln € scale

        # Perturb each dimension independently
        for i, p_name in enumerate(param_names):
            x_pert = np.copy(x_base)
            delta_val = (
                param_bounds[p_name][1] - param_bounds[p_name][0]
            ) * grid_step

            # Keep step within bounds
            if x_pert[i] + delta_val <= param_bounds[p_name][1]:
                x_pert[i] += delta_val
                step_actual = delta_val
            else:
                x_pert[i] -= delta_val
                step_actual = -delta_val

            p_dict_pert = dict(zip(param_names, x_pert))
            fin_pert = calculate_plant_financials(
                p_dict_pert["eta"],
                p_dict_pert["P_CO2"],
                p_dict_pert["P_elec"],
                p_dict_pert["OPEX_spec"],
                plant_row,
            )
            y_pert = fin_pert["Profit"] / 1e6

            # Elementary effect calculation
            ee = (y_pert - y_base) / (step_actual / (param_bounds[p_name][1] - param_bounds[p_name][0]))
            ee_store[p_name].append(ee)

    morris_summary = []
    for p_name in param_names:
        effects = np.array(ee_store[p_name])
        mu_star = np.mean(np.abs(effects))
        sigma = np.std(effects)
        morris_summary.append(
            {
                "Parameter": p_name,
                "mu_star (Impact Strength)": round(mu_star, 3),
                "sigma (Non-Linearity/Interaction)": round(sigma, 3),
            }
        )

    return pd.DataFrame(morris_summary)


# Execute Morris Analysis for Swiss Plant as baseline
df_morris = morris_screening(plants.iloc[0])
print(f"Morris Screening Results for Plant: {plants.iloc[0]['Plant']}")
print(df_morris.to_string(index=False))


