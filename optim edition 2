import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# ==========================================
# 1. INPUT DATA & PLANT COEFFICIENTS
# ==========================================
plants = pd.DataFrame(
    {
        "Plant": ["Swiss", "Dania", "Norway", "Poland"],
        "Qcapt": [1.80, 1.42, 0.40, 2.457],  # mln t/year
        "P_elec": [36, 70, 51, 96],  # €/MWh
        "P_CO2": [83, 83, 83, 83],  # €/t
        "E_spec_Pelec_table": [32.40, 63.00, 45.90, 86.40],
        "OPEX_spec": [30, 30, 30, 30],  # €/t
    }
)

S = 0.0  # Carbon subsidy (€/t)
eta_actual = 0.90  # Base capture efficiency

# Compute plant specific baseline parameters
plants["E_spec"] = plants["E_spec_Pelec_table"] / plants["P_elec"]
plants["E0"] = plants["E_spec"] * (1 - eta_actual)


# ==========================================
# 2. CORE REGRESSION MODEL (Econometric Base)
# ==========================================
def calculate_plant_financials(
    eta_val, p_co2_val, p_elec_val, opex_spec_val, plant_row, subsidy=0.0
):
    """Calculates absolute financials (Revenue, Costs, Profit) in EUR/year."""
    Qmax = plant_row["Qcapt"] / eta_actual

    capacity = Qmax
    labor_hours = 12000 * Qmax
    total_cement_prod = eta_val * Qmax * 1.5
    num_kilns = 2.0
    pct_masonry, pct_4_or_other, pct_wet = 0.15, 0.20, 0.05

    beta0, beta1, beta2, beta3 = 0.80, -0.04, 0.02, 0.12
    beta4, beta5, beta6, beta7 = 0.05, -0.08, 0.03, 0.15

    E_i = (
        beta0
        + beta1 * np.log(capacity)
        + beta2 * np.log(labor_hours)
        + beta3 * np.log(total_cement_prod)
        + beta4 * np.log(num_kilns)
        + beta5 * pct_masonry
        + beta6 * pct_4_or_other
        + beta7 * pct_wet
    )

    ref_prod = eta_actual * Qmax * 1.5
    E_i_ref = (
        beta0
        + beta1 * np.log(capacity)
        + beta2 * np.log(labor_hours)
        + beta3 * np.log(ref_prod)
        + beta4 * np.log(num_kilns)
        + beta5 * pct_masonry
        + beta6 * pct_4_or_other
        + beta7 * pct_wet
    )

    target_E_spec = plant_row["E_spec"]
    E_spec_m = (
        target_E_spec
        * (E_i / E_i_ref)
        * (1.0 + 0.45 * (eta_val / eta_actual - 1.0))
    )

    # Volume captured (tons/year)
    Q_captured_tons = eta_val * Qmax * 1e6

    # Financial Components (€/year)
    Revenue = Q_captured_tons * (p_co2_val + subsidy)
    Electricity_Cost = Q_captured_tons * E_spec_m * p_elec_val
    Fixed_Opex = opex_spec_val * plant_row["Qcapt"] * 1e6
    Total_Cost = Electricity_Cost + Fixed_Opex

    Profit = Revenue - Total_Cost

    return {
        "Revenue": Revenue,
        "Total_Cost": Total_Cost,
        "Elec_Cost": Electricity_Cost,
        "Fixed_Opex": Fixed_Opex,
        "Profit": Profit,
        "E_spec": E_spec_m,
    }


# ==========================================
# 3. ABSOLUTE FINITE-DIFFERENCE & RELATIVE ANALYSIS
# ==========================================
print("\n" + "=" * 80)
print("1. FINITE-DIFFERENCE EFFECTS (EUR/year) & RELATIVE IMPACT (% Revenue/Cost)")
print("=" * 80)

delta = 0.05  # 5% perturbation step size
fd_results = []

for _, row in plants.iterrows():
    plant_name = row["Plant"]
    base_eta = 0.90
    base_pco2 = row["P_CO2"]
    base_pelec = row["P_elec"]
    base_opex = row["OPEX_spec"]

    base_fin = calculate_plant_financials(
        base_eta, base_pco2, base_pelec, base_opex, row
    )
    F_base = base_fin["Profit"]
    Rev_base = base_fin["Revenue"]
    Cost_base = base_fin["Total_Cost"]

    # Parameter Perturbations
    params_to_test = {
        "CO2 Price (P_CO2)": (
            base_eta,
            base_pco2 * (1 + delta),
            base_pelec,
            base_opex,
        ),
        "Electricity Price (P_elec)": (
            base_eta,
            base_pco2,
            base_pelec * (1 + delta),
            base_opex,
        ),
        "OPEX Spec": (
            base_eta,
            base_pco2,
            base_pelec,
            base_opex * (1 + delta),
        ),
        "Capture Efficiency (eta)": (
            base_eta * (1 + delta),
            base_pco2,
            base_pelec,
            base_opex,
        ),
    }

    for param_name, (e, p_c, p_e, o) in params_to_test.items():
        fin_pert = calculate_plant_financials(e, p_c, p_e, o, row)
        F_pert = fin_pert["Profit"]

        # 1. Absolute Finite-Difference Effect (EUR/year)
        abs_diff_eur = F_pert - F_base

        # 2. Percentage Changes relative to Revenue and Total Cost
        pct_of_revenue = (abs_diff_eur / Rev_base) * 100
        pct_of_total_cost = (abs_diff_eur / Cost_base) * 100

        fd_results.append(
            {
                "Plant": plant_name,
                "Parameter (+5%)": param_name,
                "Absolute Effect (€/year)": round(abs_diff_eur, 2),
                "% of Total Revenue": round(pct_of_revenue, 2),
                "% of Total Cost": round(pct_of_total_cost, 2),
            }
        )

df_fd = pd.DataFrame(fd_results)
print(df_fd.to_string(index=False))


